{
  "name": "demo-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "rebuild": "chmod +x rebuild.sh && ./rebuild.sh",
    "prebuild": "expo prebuild --clean",
    "pods:install": "cd ios && LANG=en_US.UTF-8 pod install && cd ..",
    "pods:clean": "cd ios && rm -rf Pods Podfile.lock && cd .. && npm run pods:install",
    "check-java": "/usr/libexec/java_home -V",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@pylon/react-native-chat": "file:..",
    "expo": "~54.0.35",
    "expo-dev-client": "~6.0.18",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2"
  },
  "overrides": {
    "@xmldom/xmldom@^0.8.8": "^0.8.15",
    "@xmldom/xmldom@^0.9.10": "^0.9.12",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion@^1.1.7": "^1.1.21",
    "brace-expansion@^2.0.2": "^2.1.7",
    "brace-expansion@^5.0.5": "^5.0.12",
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.8",
