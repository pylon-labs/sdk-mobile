# Pylon Chat Flutter demo — configuration
#
# Copy this file to .env and run ./run.sh, which forwards every value here to
# `flutter run` as a --dart-define.

# Your Pylon app ID (from https://app.usepylon.com/settings)
PYLON_APP_ID=your-app-id-here

# Widget endpoint. Leave unset to use production (widget.usepylon.com).
# Local development:
#   iOS simulator reaches the host directly:  http://localhost:9002
#   Android emulator needs the host alias:    http://10.0.2.2:9002
# PYLON_WIDGET_BASE_URL=https://widget.usepylon.com

# Test user
PYLON_USER_EMAIL=demo@example.com
PYLON_USER_NAME=Demo User

# Identity verification hash, generated by your server.
# PYLON_USER_EMAIL_HASH=

# Diagnostics
PYLON_ENABLE_LOGGING=true
# Draws the SDK's hit test regions over the widget.
PYLON_DEBUG_MODE=false
